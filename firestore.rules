rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function memberPath(householdId, uid) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(uid);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }

    function isHouseholdMember(householdId) {
      return signedIn() && exists(memberPath(householdId, request.auth.uid));
    }

    function inviteMatchesHousehold(householdId) {
      return request.resource.data.inviteCode is string
        && exists(invitePath(request.resource.data.inviteCode))
        && get(invitePath(request.resource.data.inviteCode)).data.householdId == householdId;
    }

    function householdCreatorAfterWrite(householdId) {
      return getAfter(householdPath(householdId)).data.createdBy == request.auth.uid;
    }

    function itemBelongsToHousehold(householdId) {
      return request.resource.data.householdId == householdId;
    }

    function existingItemBelongsToHousehold(householdId) {
      return resource.data.householdId == householdId;
    }

    function itemStaysInHousehold(householdId) {
      return existingItemBelongsToHousehold(householdId)
        && request.resource.data.householdId == householdId;
    }

    function memberStaysSameUser(householdId, uid) {
      return resource.data.householdId == householdId
        && resource.data.userId == uid
        && request.resource.data.householdId == householdId
        && request.resource.data.userId == uid
        && request.resource.data.joinedAt == resource.data.joinedAt;
    }

    function requesterIsHouseholdAdmin(householdId) {
      return isHouseholdMember(householdId)
        && get(memberPath(householdId, request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.householdId is string
        && householdCreatorAfterWrite(request.resource.data.householdId);
      allow update, delete: if false;
    }

    match /households/{householdId} {
      allow read, update: if isHouseholdMember(householdId);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if false;

      match /members/{uid} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isSelf(uid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.householdId == householdId
          && (
            householdCreatorAfterWrite(householdId)
            || inviteMatchesHousehold(householdId)
          );
        allow update: if memberStaysSameUser(householdId, uid)
          && (
            (isSelf(uid) && request.resource.data.role == resource.data.role)
            || requesterIsHouseholdAdmin(householdId)
          );
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && itemBelongsToHousehold(householdId);
        allow update: if isHouseholdMember(householdId) && itemStaysInHousehold(householdId);
        allow delete: if isHouseholdMember(householdId) && existingItemBelongsToHousehold(householdId);
      }

      match /chores/{recordId} {
        // Retained records are intentionally preserved while the retired feature is inaccessible.
        allow read, write: if false;
      }

      match /fridgeItems/{itemId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && itemBelongsToHousehold(householdId);
        allow update: if isHouseholdMember(householdId) && itemStaysInHousehold(householdId);
        allow delete: if isHouseholdMember(householdId) && existingItemBelongsToHousehold(householdId);
      }
    }
  }
}
