rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function memberPath(householdId, uid) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(uid);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }

    function isHouseholdMember(householdId) {
      return signedIn() && exists(memberPath(householdId, request.auth.uid));
    }

    function inviteMatchesHousehold(householdId) {
      return request.resource.data.inviteCode is string
        && exists(invitePath(request.resource.data.inviteCode))
        && get(invitePath(request.resource.data.inviteCode)).data.householdId == householdId;
    }

    function householdCreatorAfterWrite(householdId) {
      return getAfter(householdPath(householdId)).data.createdBy == request.auth.uid;
    }

    function itemBelongsToHousehold(householdId) {
      return request.resource.data.householdId == householdId;
    }

    function existingItemBelongsToHousehold(householdId) {
      return resource.data.householdId == householdId;
    }

    function itemStaysInHousehold(householdId) {
      return existingItemBelongsToHousehold(householdId)
        && request.resource.data.householdId == householdId;
    }

    function memberStaysSameUser(householdId, uid) {
      return resource.data.householdId == householdId
        && resource.data.userId == uid
        && request.resource.data.householdId == householdId
        && request.resource.data.userId == uid
        && request.resource.data.joinedAt == resource.data.joinedAt;
    }

    function requesterIsHouseholdAdmin(householdId) {
      return isHouseholdMember(householdId)
        && get(memberPath(householdId, request.auth.uid)).data.role == 'admin';
    }

    function createsInitialHouseholdMemberIndex() {
      return request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid;
    }

    function householdMemberIndexStaysSame() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds']);
    }

    function addsRequesterToHouseholdMemberIndex(householdId) {
      let previousMemberIds = 'memberIds' in resource.data
        ? resource.data.memberIds
        : [resource.data.createdBy];
      return signedIn()
        && 'memberIds' in resource.data
        && previousMemberIds is list
        && previousMemberIds.size() == 1
        && previousMemberIds[0] == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds == previousMemberIds.concat([request.auth.uid])
        && exists(memberPath(householdId, previousMemberIds[0]))
        && !exists(memberPath(householdId, request.auth.uid))
        && existsAfter(memberPath(householdId, request.auth.uid));
    }

    function initializesLegacyHouseholdMemberIndex(householdId) {
      let memberIds = request.resource.data.memberIds;
      return signedIn()
        && !('memberIds' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && memberIds is list
        && memberIds.size() >= 1
        && memberIds.size() <= 2
        && memberIds[0] == resource.data.createdBy
        && exists(memberPath(householdId, memberIds[0]))
        && (
          memberIds.size() == 1
          || (
            memberIds[0] != memberIds[1]
            && exists(memberPath(householdId, memberIds[1]))
          )
        )
        && (
          requesterIsHouseholdAdmin(householdId)
          || (
            memberIds.size() == 2
            && request.auth.uid == memberIds[1]
            && exists(memberPath(householdId, request.auth.uid))
          )
        );
    }

    function requesterIsIndexedAfterWrite(householdId) {
      let memberIds = getAfter(householdPath(householdId)).data.memberIds;
      return memberIds is list
        && memberIds.size() <= 2
        && memberIds.hasAny([request.auth.uid]);
    }

    function validMonthlyBudget(householdId) {
      let memberIds = getAfter(householdPath(householdId)).data.memberIds;
      let contributions = request.resource.data.memberContributions;
      let firstContribution = contributions[memberIds[0]];
      let secondContribution = contributions[memberIds[1]];
      return memberIds is list
        && memberIds.size() == 2
        && memberIds[0] is string
        && memberIds[1] is string
        && memberIds[0] != memberIds[1]
        && exists(memberPath(householdId, memberIds[0]))
        && exists(memberPath(householdId, memberIds[1]))
        && request.resource.data.totalAmount is int
        && request.resource.data.totalAmount > 0
        && request.resource.data.contributionMode in ['equal', 'custom']
        && contributions is map
        && contributions.keys().size() == 2
        && contributions.keys().hasAll(memberIds)
        && firstContribution is int
        && secondContribution is int
        && firstContribution >= 0
        && secondContribution >= 0
        && firstContribution + secondContribution == request.resource.data.totalAmount
        && (
          request.resource.data.contributionMode != 'equal'
          || (
            firstContribution >= secondContribution
            && firstContribution - secondContribution <= 1
          )
        );
    }

    function validRecurringExpenseTemplate(householdId) {
      return itemBelongsToHousehold(householdId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.frequency == 'monthly'
        && request.resource.data.paymentDay is int
        && request.resource.data.paymentDay >= 1
        && request.resource.data.paymentDay <= 31
        && (
          request.resource.data.expectedAmount == null
          || (
            request.resource.data.expectedAmount is int
            && request.resource.data.expectedAmount >= 0
          )
        )
        && request.resource.data.startsOn is string
        && request.resource.data.active is bool;
    }

    function scheduledExpenseSnapshotStaysSame() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'amount', 'amountStatus', 'status', 'expenseId', 'updatedAt'
      ]);
    }

    function validScheduledExpenseSnapshot(householdId) {
      let template = get(
        /databases/$(database)/documents/households/$(householdId)/recurringExpenseTemplates/$(request.resource.data.templateId)
      );
      let due = timestamp(request.resource.data.dueDate + 'T00:00:00Z');
      let nextDay = due + duration.value(1, 'd');
      return request.resource.data.title == template.data.title
        && request.resource.data.category == template.data.category
        && (
          (!('paymentMethod' in template.data) && !('paymentMethod' in request.resource.data))
          || request.resource.data.paymentMethod == template.data.paymentMethod
        )
        && (
          (!('payerId' in template.data) && !('payerId' in request.resource.data))
          || request.resource.data.payerId == template.data.payerId
        )
        && request.resource.data.amount == template.data.expectedAmount
        && request.resource.data.dueDate.matches('^' + request.resource.data.month + '-[0-9]{2}$')
        && (
          due.day() == template.data.paymentDay
          || (
            due.day() < template.data.paymentDay
            && nextDay.month() != due.month()
          )
        );
    }

    function confirmsScheduledExpenseAmount() {
      return resource.data.status == 'scheduled'
        && request.resource.data.status == 'scheduled'
        && request.resource.data.amount is int
        && request.resource.data.amount >= 0
        && request.resource.data.amountStatus == 'confirmed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amount', 'amountStatus', 'updatedAt'
        ]);
    }

    function processesScheduledExpense(householdId, scheduledExpenseId) {
      let expense = getAfter(
        /databases/$(database)/documents/households/$(householdId)/expenses/$(request.resource.data.expenseId)
      );
      return resource.data.status == 'scheduled'
        && request.resource.data.status == 'processed'
        && request.resource.data.amount is int
        && request.resource.data.amount >= 0
        && request.resource.data.amountStatus in ['estimated', 'confirmed']
        && request.resource.data.expenseId is string
        && expense.data.scheduledExpenseId == scheduledExpenseId
        && expense.data.recurringTemplateId == request.resource.data.templateId
        && expense.data.amount == request.resource.data.amount
        && expense.data.dueDate == request.resource.data.dueDate
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'expenseId', 'updatedAt'
        ]);
    }

    function validLinkedScheduledExpense(householdId, expenseId) {
      let scheduledId = request.resource.data.scheduledExpenseId;
      let scheduled = getAfter(
        /databases/$(database)/documents/households/$(householdId)/scheduledExpenses/$(scheduledId)
      );
      return scheduledId is string
        && scheduled.data.status == 'processed'
        && scheduled.data.expenseId == expenseId
        && request.resource.data.recurringTemplateId == scheduled.data.templateId
        && request.resource.data.amount == scheduled.data.amount
        && request.resource.data.dueDate == scheduled.data.dueDate
        && request.resource.data.status == 'paid';
    }

    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.householdId is string
        && householdCreatorAfterWrite(request.resource.data.householdId);
      allow update, delete: if false;
    }

    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      allow update: if (
        isHouseholdMember(householdId)
        && householdMemberIndexStaysSame()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
      )
        || initializesLegacyHouseholdMemberIndex(householdId)
        || addsRequesterToHouseholdMemberIndex(householdId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && createsInitialHouseholdMemberIndex();
      allow delete: if false;

      match /members/{uid} {
        allow get: if isSelf(uid) || isHouseholdMember(householdId);
        allow list: if isHouseholdMember(householdId);
        allow create: if isSelf(uid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.householdId == householdId
          && requesterIsIndexedAfterWrite(householdId)
          && (
            householdCreatorAfterWrite(householdId)
            || inviteMatchesHousehold(householdId)
          );
        allow update: if memberStaysSameUser(householdId, uid)
          && (
            (isSelf(uid) && request.resource.data.role == resource.data.role)
            || requesterIsHouseholdAdmin(householdId)
          );
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && itemBelongsToHousehold(householdId)
          && (
            !('scheduledExpenseId' in request.resource.data)
            || validLinkedScheduledExpense(householdId, expenseId)
          );
        allow update: if isHouseholdMember(householdId)
          && itemStaysInHousehold(householdId)
          && !('scheduledExpenseId' in resource.data);
        allow delete: if isHouseholdMember(householdId)
          && existingItemBelongsToHousehold(householdId)
          && !('scheduledExpenseId' in resource.data);
      }

      match /recurringExpenseTemplates/{templateId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && validRecurringExpenseTemplate(householdId);
        allow update: if isHouseholdMember(householdId)
          && itemStaysInHousehold(householdId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && validRecurringExpenseTemplate(householdId);
        allow delete: if isHouseholdMember(householdId)
          && existingItemBelongsToHousehold(householdId);
      }

      match /scheduledExpenses/{scheduledExpenseId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && itemBelongsToHousehold(householdId)
          && request.resource.data.templateId is string
          && scheduledExpenseId == request.resource.data.templateId + '__' + request.resource.data.month
          && exists(
            /databases/$(database)/documents/households/$(householdId)/recurringExpenseTemplates/$(request.resource.data.templateId)
          )
          && validScheduledExpenseSnapshot(householdId)
          && request.resource.data.status == 'scheduled'
          && request.resource.data.amountStatus in ['estimated', 'needs-confirmation']
          && (
            (
              request.resource.data.amount == null
              && request.resource.data.amountStatus == 'needs-confirmation'
            )
            || (
              request.resource.data.amount is int
              && request.resource.data.amount >= 0
              && request.resource.data.amountStatus == 'estimated'
            )
          );
        allow update: if isHouseholdMember(householdId)
          && itemStaysInHousehold(householdId)
          && scheduledExpenseSnapshotStaysSame()
          && (
            confirmsScheduledExpenseAmount()
            || processesScheduledExpense(householdId, scheduledExpenseId)
          );
        allow delete: if false;
      }

      match /monthlyBudgets/{month} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && itemBelongsToHousehold(householdId)
          && request.resource.data.month == month
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.revision == 1
          && validMonthlyBudget(householdId);
        allow update: if isHouseholdMember(householdId)
          && itemStaysInHousehold(householdId)
          && request.resource.data.month == month
          && resource.data.month == month
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && (
            (
              !('revision' in resource.data)
              && request.resource.data.revision == 2
            )
            || (
              resource.data.revision is int
              && request.resource.data.revision == resource.data.revision + 1
            )
          )
          && validMonthlyBudget(householdId);
        allow delete: if false;
      }

      match /chores/{recordId} {
        // Retained records are intentionally preserved while the retired feature is inaccessible.
        allow read, write: if false;
      }

      match /fridgeItems/{itemId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && itemBelongsToHousehold(householdId);
        allow update: if isHouseholdMember(householdId) && itemStaysInHousehold(householdId);
        allow delete: if isHouseholdMember(householdId) && existingItemBelongsToHousehold(householdId);
      }
    }
  }
}
