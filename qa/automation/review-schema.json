{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "findings"],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "title",
          "evidence",
          "file",
          "line",
          "acceptanceCriteria",
          "fingerprint"
        ],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": ["integer", "null"]
          },
          "acceptanceCriteria": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          }
        }
      }
    }
  }
}

