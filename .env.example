# Firebase/Supabase 등 백엔드 연결 시 공개 가능한 클라이언트 키만 EXPO_PUBLIC_ 접두사로 둡니다.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_BACKEND_PROVIDER=firebase
EXPO_PUBLIC_QA_MODE=false
# QA 모드가 원격 게이트웨이를 사용할 때만 지정합니다. 내부망에서는 현재 호스트의 8787 포트를 자동 사용합니다.
EXPO_PUBLIC_QA_GATEWAY_URL=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
