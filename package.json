{
  "name": "jalsarabose",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "expo": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.10",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "express": "^5.2.1",
    "firebase": "^12.14.0",
    "lucide-react-native": "^1.18.0",
    "multer": "^2.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "rrweb": "^2.0.0-alpha.20",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "playwright-core": "^1.62.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:mock": "EXPO_PUBLIC_USE_MOCKS=true expo start --web",
    "qa:setup": "node qa/setup.mjs",
    "qa:gateway": "node qa/server/index.mjs",
    "qa:lan": "concurrently --kill-others --names APP,QA --prefix-colors green,cyan \"EXPO_PUBLIC_QA_MODE=true expo start --web --lan --port 8081\" \"node qa/server/index.mjs\"",
    "qa:replay": "node qa/automation/replay.mjs",
    "qa:review": "node qa/automation/claude-review.mjs",
    "qa:nightly": "node qa/automation/nightly-runner.mjs",
    "qa:nightly:dry": "node qa/automation/nightly-runner.mjs --dry-run --once --force",
    "qa:daily": "node qa/automation/daily-regression.mjs",
    "qa:daily:dry": "node qa/automation/daily-regression.mjs --dry-run --force",
    "qa:configure-github": "node qa/automation/configure-github.mjs",
    "qa:install-schedule": "node qa/automation/install-schedule.mjs",
    "qa:test": "node --test qa/**/*.test.mjs",
    "export:web": "expo export --platform web && node scripts/prepare-sites-build.mjs",
    "export:web:mock": "EXPO_PUBLIC_USE_MOCKS=true expo export --platform web --output-dir dist-mock",
    "verify:env": "node scripts/verify-env.mjs",
    "verify": "node scripts/verify-project.mjs",
    "demo:seed": "node scripts/firebase-demo-data.mjs",
    "demo:reset": "node scripts/firebase-demo-data.mjs --reset-only",
    "smoke:firebase": "node scripts/firebase-smoke-test.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
